		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "^12.2.0",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"strip-ansi": "^7.2.0",
		"supertest": "^7.3.1"
	}

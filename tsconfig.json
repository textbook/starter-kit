{
	"extends": "@tsconfig/node22/tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"composite": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"tsBuildInfoFile": "${configDir}/node_modules/.cache/tsconfig.tsbuildinfo"
	},
	"files": ["vite.config.ts"],
	"references": [
		{ "path": "./api" },
		{ "path": "./e2e" },
		{ "path": "./linting" }
	]
}
